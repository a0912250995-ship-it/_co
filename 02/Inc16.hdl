// File name: projects/02/Inc16.hdl

/**
 * 16 位元加一器 (Incrementer)：
 * out = in + 1 (算術加法)
 */

CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:
    // 將輸入 in 與 1 (即 b[0]=true，其餘位元自動為 0) 相加
    Add16(a=in, b[0]=true, out=out);
}